# Surebet Scanner — copy to .env (docker compose) or backend/.env (local run)

# Backend
DATABASE_URL=postgresql+psycopg://surebet:surebet@localhost:5432/surebet
# Local fallback (default): DATABASE_URL=sqlite:///./surebet.db
REDIS_URL=redis://localhost:6379/0
FEED_AUTOSTART=1
FEED_TICK_SECONDS=5
DEMO_MODE=1
DEMO_SEED=20240601
MIN_ROI_PCT=0.5
ODDS_MAX_AGE_SECONDS=180
CORS_ORIGINS=http://localhost:3000

# Optional external providers (leave empty for pure demo mode)
THEODDSAPI_KEY=
THEODDSAPI_REGION=eu
# Comma-separated The Odds API sport keys (https://the-odds-api.com/sports-odds-data/sports-apis.html)
THEODDSAPI_SPORTS=soccer_epl
# Markets requested per pull: h2h,spreads,totals (each sport-request costs 1+ quota)
THEODDSAPI_MARKETS=h2h,spreads,totals
# Minimum seconds between real-provider pulls (quota protection)
THEODDSAPI_MIN_INTERVAL_SECONDS=60
SPORTSRADAR_KEY=
APISPORTS_KEY=

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live
